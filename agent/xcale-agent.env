# /etc/xcale-agent.env: settings of the xcale agent (chmod 600, it holds the cluster token)
XCALE_URL=ws://100.64.12.2:4000/agent
# plain ws:// is refused without this (isolated networks only)
XCALE_INSECURE=1
XCALE_CLUSTER=teplushka_01
XCALE_TOKEN=<cluster token>
XCALE_ROOT=/opt/agent/root
# the name of the node; by default the host name up to the first dot
#XCALE_NODE=
# for wss:// with a certificate that the system does not know
#XCALE_CACERT=/etc/xcale/ca.pem
